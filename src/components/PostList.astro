---
import { formatDate, type Post } from '../lib/posts';

interface Props { posts: Post[]; showPins?: boolean; }
const { posts, showPins = false } = Astro.props;
---
<ul class="post-list">
  {posts.map((post) => (
    <li>
      <a href={`/posts/${post.id}/`}>
        <div class="post-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {showPins && post.data.pinned && <span class="pin-badge">Pinned</span>}
        </div>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
      </a>
    </li>
  ))}
</ul>
