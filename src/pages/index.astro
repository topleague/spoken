---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config';
import { getPosts, withPinsFirst } from '../lib/posts';

const posts = withPinsFirst(await getPosts());
---
<Base>
  <section class="hero">
    <h1>{SITE.tagline}</h1>
    <p>Essays and short notes. No tracking, no feeds to fight, just words on a page.</p>
  </section>
  <PostList posts={posts} showPins />
</Base>
