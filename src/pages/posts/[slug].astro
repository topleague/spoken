---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPosts, formatDate, slugify } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const date = formatDate(post.data.date);
const { tags, category } = post.data;
---
<Base title={post.data.title} description={post.data.description}>
  <a class="back" href="/">← All writing</a>
  <!-- data-pagefind-body: only post pages are added to the search index -->
  <article data-pagefind-body>
    <header class="article-head">
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{date}</time> · {minutes} min read
        {category && (<> · <a href={`/category/${slugify(category)}/`} data-pagefind-filter="category">{category}</a></>)}
      </div>
      <h1>{post.data.title}</h1>
      {tags.length > 0 && (
        <ul class="tag-list" aria-label="Tags">
          {tags.map((t) => (
            <li><a href={`/tags/${slugify(t)}/`} data-pagefind-filter="tag">{t}</a></li>
          ))}
        </ul>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
