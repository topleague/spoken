
---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPosts, formatDate, slugify } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const searchHeadings = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 6
);

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const date = formatDate(post.data.date);
const { tags, category } = post.data;
---

<Base title={post.data.title} description={post.data.description}>
  <a class="back" href="/">← All writing</a>

  <!-- Pagefind indexes only this dedicated headline area. -->
  <div class="pagefind-index" data-pagefind-body aria-hidden="true">
    <h1>{post.data.title}</h1>
    {searchHeadings.map((heading) => <p>{heading.text}</p>)}
  </div>

  <!-- The visible article is excluded from the search index. -->
  <article data-pagefind-ignore="all">
    <header class="article-head">
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{date}</time> · {minutes} min read
        {category && (<> · <a href={`/category/${slugify(category)}/`}>{category}</a></>)}
      </div>

      <h1>{post.data.title}</h1>

      {tags.length > 0 && (
        <ul class="tag-list" aria-label="Tags">
          {tags.map((t) => (
            <li><a href={`/tags/${slugify(t)}/`}>{t}</a></li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  /* Visually hidden, but still available to Pagefind during indexing. */
  .pagefind-index {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
